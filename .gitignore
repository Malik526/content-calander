# Local environment values and secrets.
.env

# Python runtime artifacts.
__pycache__/
*.py[cod]

# Editable-install build metadata (pip install -e .) — regenerated locally,
# never committed. See pyproject.toml / Milestone 3.0's package refactor.
*.egg-info/

# Local safety backups created during manual migrations.
*.backup

# Content processing pipeline: personal media, derived DB, and test cache.
# Directory structure is preserved via .gitkeep; contents are user data.
content/incoming/*
content/processed/*
content/failed/*
!content/incoming/.gitkeep
!content/processed/.gitkeep
!content/failed/.gitkeep
data/*.db
data/*.db-*
data/calendar_state.json
data/backups/
.pytest_cache/

# Private golden-evaluation corpus (real creator transcripts). Only
# evaluation/README.md is committed — see that file for the format.
evaluation/labels.csv
evaluation/transcripts/*
!evaluation/transcripts/.gitkeep

# Shofo real-video evaluation corpus (Milestone 1.3.1) — downloaded MP4s,
# reference metadata, and benchmark results. Only
# evaluation/video_pipeline/README.md is committed — see that file for
# dataset access/format. Never commit downloaded Shofo videos or transcripts.
evaluation/video_pipeline/videos/*
evaluation/video_pipeline/metadata.jsonl
evaluation/video_pipeline/results.jsonl
!evaluation/video_pipeline/videos/.gitkeep

#ignore virtual environment folder 
.venv/

#ignore images
images/

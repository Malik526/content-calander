# Everything in this file is bundled into the browser (any NEXT_PUBLIC_*
# variable) or is otherwise safe to be public — never put a server-only
# secret (DATABASE_URL, a service-role key, etc.) here or anywhere in
# this package. See lib/api/client.ts and
# docs/decisions/0010-frontend-app-shell.md "Backend API Boundary
# Alignment"/"Environment Configuration".

# Base URL of the future FastAPI backend. Empty/unset today — no backend
# exists yet (see docs/architecture/hosted-product-boundary.md); product
# pages use lib/api/mockData.ts instead of a real request until this is
# set and lib/api/client.ts has a real endpoint to call.
NEXT_PUBLIC_API_BASE_URL=

# Set to "true" only for an intentional non-production preview
# deployment that should render the app shell using the development mock
# session (lib/session.tsx) instead of throwing. Never set this for the
# real production deployment.
NEXT_PUBLIC_ALLOW_MOCK_SESSION=

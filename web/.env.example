# Everything in this file is bundled into the browser (any NEXT_PUBLIC_*
# variable) or is otherwise safe to be public — never put a server-only
# secret (DATABASE_URL, a service-role key, CREDENTIAL_ENCRYPTION_KEY,
# etc.) here or anywhere in this package. See lib/api/client.ts and
# docs/decisions/0010-frontend-app-shell.md "Backend API Boundary
# Alignment"/"Environment Configuration".

# Base URL of the FastAPI backend (src/content_automation/api/, Milestone
# 3.6). Local dev default matches `python3 cli/run_api.py`'s own default
# (127.0.0.1:8000) — set explicitly once the backend is deployed
# somewhere real.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Supabase Auth (Milestone 3.6) — see lib/supabase/client.ts. Both values
# are meant to be public: the anon key is a public API key by Supabase's
# own design (Row Level Security, never secrecy, protects data behind
# it) — never confuse it with the server-only service-role key, which has
# no reason to exist anywhere in this package. Find both in the Supabase
# dashboard under Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Without both Supabase values set, lib/session.tsx falls back to a
# loudly-marked development-only mock user — but ONLY outside a
# production build (`NODE_ENV=production`). There is no flag that
# re-enables that fallback in production anymore (Milestone 3.5's
# NEXT_PUBLIC_ALLOW_MOCK_SESSION was removed once real authentication
# shipped in Milestone 3.6) — a production build with Supabase
# unconfigured fails closed unconditionally. See
# docs/decisions/0011-real-authentication-and-tiktok-connection.md
# "Authentication".
